# Copy to .env; replace both database passwords before first start.
MYSQL_PASSWORD=CHANGE_ME_USE_LONG_RANDOM_VALUE
MYSQL_ROOT_PASSWORD=CHANGE_ME_ANOTHER_LONG_RANDOM_VALUE
APP_PORT=8080
# Only the first boot provisions a SYS_ADMIN; remove bootstrap password afterwards.
AUTH_BOOTSTRAP_EMAIL=admin@example.org
AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_A_UNIQUE_LONG_PASSWORD
# Optional: configure external/local LLM provider on the server, not in the browser.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
FINNHUB_API_KEY=

# Web search API token (server-side only). No web tool until configured.
BRAVE_SEARCH_API_KEY=
# Default agent budgets when no SYS_ADMIN overrides are stored in MySQL.
AI_MAX_STEPS=12
AI_MAX_TOOL_CALLS=48
# Pinned release tag or stable (automatic app-only updates).
FLOWEYSALES_TAG=stable
# Keep false for localhost HTTP. Set true behind a real HTTPS reverse proxy.
AUTH_COOKIE_SECURE=false

# Mandatory real contact string for querying SEC EDGAR from Go (otherwise SEC tools explicitly fail).
SEC_USER_AGENT=FloweySales Research contact@example.com
