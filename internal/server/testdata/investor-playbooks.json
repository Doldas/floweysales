 "quality-screen/admin": {
  "name": "Quality & value screen",
  "intervalMinutes": 10080,
  "graph": {
   "version": 2,
   "nodes": [
    {
     "id": "start",
     "type": "trigger",
     "label": "Start",
     "x": 40,
     "y": 160
    },
    {
     "id": "fund",
     "type": "fundamentals",
     "label": "Fundamentals",
     "symbols": "AAPL, MSFT, NVDA, AMZN, GOOGL",
     "x": 215,
     "y": 160
    },
    {
     "id": "screen",
     "type": "screen",
     "label": "Quality & value",
     "rule": "revenue_growth_pct >= 10 and net_margin_pct >= 15 and pe_ttm < 35",
     "sort_by": "-revenue_growth_pct",
     "limit": 10,
     "x": 390,
     "y": 160
    },
    {
     "id": "table",
     "type": "report_table",
     "label": "Shortlist",
     "title": "Quality & value shortlist",
     "columns": "symbol,price,pe_ttm,revenue_growth_pct,net_margin_pct,eps_growth_pct,ttm_through",
     "skip_empty": true,
     "x": 565,
     "y": 160
    },
    {
     "id": "memo",
     "type": "agent",
     "label": "Memo bullets",
     "require_grounding": true,
     "prompt": "Use only figures that appear in the input data and name the date they are as of. For each company in the shortlist write three bullets: what the numbers show (facts), what would have to be true for the stock to work (assumptions), and the main risk. Keep the table at the top. This is research, not a recommendation.",
     "x": 740,
     "y": 160
    },
    {
     "id": "notify",
     "type": "notify",
     "label": "Email me",
     "channel": "email",
     "subject": "Quality & value shortlist {{date}}",
     "x": 915,
     "y": 160
    }
   ],
   "edges": [
    {
     "from": "start",
     "to": "fund"
    },
    {
     "from": "fund",
     "to": "screen"
    },
    {
     "from": "screen",
     "to": "table"
    },
    {
     "from": "table",
     "to": "memo"
    },
    {
     "from": "memo",
     "to": "notify"
    }
   ]
  },
  "note": "Weekly screen on trailing-twelve-month figures. Adjust the thresholds in the screen rule."
 },
