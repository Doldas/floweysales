 "news-digest/admin": {
  "name": "News catalyst digest",
  "intervalMinutes": 240,
  "graph": {
   "version": 2,
   "nodes": [
    {
     "id": "start",
     "type": "trigger",
     "label": "Start",
     "x": 40,
     "y": 160
    },
    {
     "id": "news",
     "type": "news",
     "label": "Headlines",
     "symbols": "AAPL, MSFT, NVDA, AMZN, GOOGL",
     "limit": 5,
     "lookback_days": 2,
     "x": 215,
     "y": 160
    },
    {
     "id": "new",
     "type": "only_new",
     "label": "New headlines",
     "x": 390,
     "y": 160
    },
    {
     "id": "digest",
     "type": "agent",
     "label": "Digest",
     "skip_empty": true,
     "prompt": "Group the new headlines in the input by symbol into likely catalysts and risks. One line each, with the link. Treat headlines as claims from their source, not facts, and skip duplicates.",
     "x": 565,
     "y": 160
    },
    {
     "id": "notify",
     "type": "notify",
     "label": "Email me",
     "channel": "email",
     "subject": "News digest {{date}}",
     "x": 740,
     "y": 160
    }
   ],
   "edges": [
    {
     "from": "start",
     "to": "news"
    },
    {
     "from": "news",
     "to": "new"
    },
    {
     "from": "new",
     "to": "digest"
    },
    {
     "from": "digest",
     "to": "notify"
    }
   ]
  },
  "note": "Needs a provider plugin with the news capability (Yahoo or Finnhub). Silent when there are no new headlines."
 },
