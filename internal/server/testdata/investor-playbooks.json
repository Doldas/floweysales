 "price-alerts/admin": {
  "name": "Price move alerts",
  "intervalMinutes": 60,
  "graph": {
   "version": 2,
   "nodes": [
    {
     "id": "start",
     "type": "trigger",
     "label": "Start",
     "x": 40,
     "y": 160
    },
    {
     "id": "quotes",
     "type": "watchlist_quotes",
     "label": "Watchlist quotes",
     "symbols": "AAPL, MSFT, NVDA, AMZN, GOOGL",
     "x": 215,
     "y": 160
    },
    {
     "id": "moves",
     "type": "screen",
     "label": "Big moves",
     "rule": "change_1d_pct <= -4 or from_high_pct <= -20",
     "sort_by": "change_1d_pct",
     "x": 390,
     "y": 160
    },
    {
     "id": "new",
     "type": "only_new",
     "label": "Once a day",
     "key_fields": "symbol",
     "cooldown_hours": 24,
     "x": 565,
     "y": 160
    },
    {
     "id": "report",
     "type": "report_table",
     "label": "Alert table",
     "title": "Price alerts",
     "columns": "symbol,price,currency,change_1d_pct,from_high_pct,as_of",
     "skip_empty": true,
     "x": 740,
     "y": 160
    },
    {
     "id": "notify",
     "type": "notify",
     "label": "Email me",
     "channel": "email",
     "subject": "{{count}} price alert(s) {{date}}",
     "x": 915,
     "y": 160
    }
   ],
   "edges": [
    {
     "from": "start",
     "to": "quotes"
    },
    {
     "from": "quotes",
     "to": "moves"
    },
    {
     "from": "moves",
     "to": "new"
    },
    {
     "from": "new",
     "to": "report"
    },
    {
     "from": "report",
     "to": "notify"
    }
   ]
  },
  "note": "Checks hourly once enabled and alerts at most once per symbol per day. Edit the screen rule to change the thresholds."
 },
