 "filings-monitor/admin": {
  "name": "SEC filing monitor",
  "intervalMinutes": 360,
  "graph": {
   "version": 2,
   "nodes": [
    {
     "id": "start",
     "type": "trigger",
     "label": "Start",
     "x": 40,
     "y": 160
    },
    {
     "id": "filings",
     "type": "sec_filings",
     "label": "Recent filings",
     "symbols": "AAPL, MSFT, NVDA, AMZN, GOOGL",
     "forms": "8-K, 10-Q, 10-K",
     "lookback_days": 3,
     "x": 215,
     "y": 160
    },
    {
     "id": "new",
     "type": "only_new",
     "label": "New filings",
     "x": 390,
     "y": 160
    },
    {
     "id": "summary",
     "type": "agent",
     "label": "Summarize",
     "skip_empty": true,
     "prompt": "For each new SEC filing in the input, say what kind of filing it is and what an investor should check in it. Flag 8-Ks that may be material (results, guidance, leadership, deals, financing). Link every filing URL. Do not guess the contents of a filing you have not read.",
     "tools": [
      "get_sec_section"
     ],
     "max_tool_calls": 6,
     "timeout_seconds": 90,
     "x": 565,
     "y": 160
    },
    {
     "id": "notify",
     "type": "notify",
     "label": "Email me",
     "channel": "email",
     "subject": "New SEC filings {{date}}",
     "x": 740,
     "y": 160
    }
   ],
   "edges": [
    {
     "from": "start",
     "to": "filings"
    },
    {
     "from": "filings",
     "to": "new"
    },
    {
     "from": "new",
     "to": "summary"
    },
    {
     "from": "summary",
     "to": "notify"
    }
   ]
  },
  "note": "Needs SEC_USER_AGENT on the server. Nothing runs past \"New filings\" when there is nothing new, so the agent costs nothing on quiet days."
 },
