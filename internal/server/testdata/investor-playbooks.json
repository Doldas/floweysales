{
 "morning-brief/admin": {
  "name": "Morning watchlist brief",
  "intervalMinutes": 1440,
  "graph": {
   "version": 2,
   "nodes": [
    {
     "id": "start",
     "type": "trigger",
     "label": "Start",
     "x": 40,
     "y": 160
    },
    {
     "id": "quotes",
     "type": "watchlist_quotes",
     "label": "Watchlist quotes",
     "symbols": "AAPL, MSFT, NVDA, AMZN, GOOGL",
     "x": 215,
     "y": 160
    },
    {
     "id": "tech",
     "type": "technical_scan",
     "label": "Technicals",
     "x": 390,
     "y": 270
    },
    {
     "id": "data",
     "type": "merge",
     "label": "Combine data",
     "x": 565,
     "y": 160
    },
    {
     "id": "brief",
     "type": "agent",
     "label": "Write brief",
     "require_grounding": true,
     "prompt": "Use only figures that appear in the input data and name the date they are as of. Write a concise morning brief for an investor: the biggest movers, stocks near their 52-week high or low, notable technical signals (RSI, trend, crosses) and what to watch today. End with a short risk note. Markdown, under 300 words.",
     "x": 740,
     "y": 160
    },
    {
     "id": "notify",
     "type": "notify",
     "label": "Email me",
     "channel": "email",
     "subject": "Morning brief {{date}}",
     "x": 915,
     "y": 160
    }
   ],
   "edges": [
    {
     "from": "start",
     "to": "quotes"
    },
    {
     "from": "quotes",
     "to": "tech"
    },
    {
     "from": "quotes",
     "to": "data"
    },
    {
     "from": "tech",
     "to": "data"
    },
    {
     "from": "data",
     "to": "brief"
    },
    {
     "from": "brief",
     "to": "notify"
    }
   ]
  },
  "note": "Runs daily once enabled. The agent can only state figures found in the quotes and technicals."
 },
