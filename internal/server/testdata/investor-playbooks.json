 "technical-setups/admin": {
  "name": "Technical setups scanner",
  "intervalMinutes": 1440,
  "graph": {
   "version": 2,
   "nodes": [
    {
     "id": "start",
     "type": "trigger",
     "label": "Start",
     "x": 40,
     "y": 160
    },
    {
     "id": "tech",
     "type": "technical_scan",
     "label": "Technical scan",
     "symbols": "AAPL, MSFT, NVDA, AMZN, GOOGL",
     "x": 215,
     "y": 160
    },
    {
     "id": "setups",
     "type": "screen",
     "label": "Setups",
     "rule": "(rsi14 < 35 and above_sma200) or cross == \"golden\"",
     "sort_by": "rsi14",
     "x": 390,
     "y": 160
    },
    {
     "id": "new",
     "type": "only_new",
     "label": "New setups",
     "key_fields": "symbol",
     "cooldown_hours": 72,
     "x": 565,
     "y": 160
    },
    {
     "id": "report",
     "type": "report_table",
     "label": "Setup table",
     "title": "Technical setups",
     "columns": "symbol,price,rsi14,ema_stack,sma200,cross,as_of",
     "skip_empty": true,
     "x": 740,
     "y": 160
    },
    {
     "id": "notify",
     "type": "notify",
     "label": "Email me",
     "channel": "email",
     "subject": "Technical setups {{date}}",
     "x": 915,
     "y": 160
    }
   ],
   "edges": [
    {
     "from": "start",
     "to": "tech"
    },
    {
     "from": "tech",
     "to": "setups"
    },
    {
     "from": "setups",
     "to": "new"
    },
    {
     "from": "new",
     "to": "report"
    },
    {
     "from": "report",
     "to": "notify"
    }
   ]
  },
  "note": "Oversold stocks still above their 200-day average, and fresh golden crosses. A setup is reported again after 3 days at most."
 },
