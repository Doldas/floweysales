<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="011-paper-order-approval-requests" author="floweysales" dbms="mysql">
  <createTable tableName="paper_order_approval_requests">
   <column name="client_order_id" type="VARCHAR(128)"><constraints primaryKey="true" nullable="false"/></column>
   <column name="request_hash" type="CHAR(64)"><constraints nullable="false"/></column>
   <column name="request_payload" type="LONGTEXT"><constraints nullable="false"/></column>
   <column name="requested_by" type="BIGINT"><constraints nullable="false"/></column>
   <column name="approved_by" type="BIGINT"/>
   <column name="approved_at" type="DATETIME(6)"/>
   <column name="consumed_order_id" type="BIGINT"/>
   <column name="created_at" type="DATETIME(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)"/>
  </createTable>
  <rollback><dropTable tableName="paper_order_approval_requests"/></rollback>
 </changeSet>
</databaseChangeLog>
