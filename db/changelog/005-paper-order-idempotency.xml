<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="009-paper-order-idempotency" author="floweysales" dbms="mysql">
  <createTable tableName="paper_order_requests">
   <column name="client_order_id" type="VARCHAR(128)"><constraints primaryKey="true" nullable="false"/></column>
   <column name="request_hash" type="CHAR(64)"><constraints nullable="false"/></column>
   <column name="order_id" type="BIGINT"><constraints nullable="false"/></column>
   <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
  </createTable>
  <createIndex tableName="paper_order_requests" indexName="idx_paper_order_requests_order">
   <column name="order_id"/>
  </createIndex>
  <rollback><dropTable tableName="paper_order_requests"/></rollback>
 </changeSet>
</databaseChangeLog>
