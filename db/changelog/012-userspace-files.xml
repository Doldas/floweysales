<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="016-userspace-files" author="floweysales" dbms="mysql">
  <createTable tableName="userspace_files">
   <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
   <column name="owner_id" type="BIGINT"><constraints nullable="false"/></column>
   <column name="path" type="VARCHAR(512)"><constraints nullable="false"/></column>
   <column name="content_type" type="VARCHAR(100)"><constraints nullable="false"/></column>
   <column name="content" type="MEDIUMBLOB"><constraints nullable="false"/></column>
   <column name="byte_size" type="INT"><constraints nullable="false"/></column>
   <column name="updated_at" type="DATETIME(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)"/>
  </createTable>
  <addForeignKeyConstraint baseTableName="userspace_files" baseColumnNames="owner_id"
    referencedTableName="auth_users" referencedColumnNames="id"
    constraintName="fk_userspace_owner" onDelete="CASCADE"/>
  <addUniqueConstraint tableName="userspace_files" columnNames="owner_id,path" constraintName="uq_userspace_owner_path"/>
  <createIndex tableName="userspace_files" indexName="idx_userspace_owner"><column name="owner_id"/></createIndex>
  <rollback><dropTable tableName="userspace_files"/></rollback>
 </changeSet>
</databaseChangeLog>
