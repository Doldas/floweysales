<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="019-api-integration-secrets" author="floweysales" dbms="mysql">
  <createTable tableName="api_integration_secrets">
   <column name="integration" type="VARCHAR(32)"><constraints primaryKey="true" nullable="false"/></column>
   <column name="provider" type="VARCHAR(40)"><constraints nullable="false"/></column>
   <column name="ciphertext" type="VARBINARY(8192)"><constraints nullable="false"/></column>
   <column name="updated_at" type="DATETIME(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)"/>
  </createTable>
  <rollback><dropTable tableName="api_integration_secrets"/></rollback>
 </changeSet>
</databaseChangeLog>