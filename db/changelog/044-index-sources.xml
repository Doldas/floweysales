<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="044-index-sources" author="floweysales" dbms="mysql">
  <!-- User-supplied index constituent lists (#258). Never shipped with the app; one row per user and index.
       No foreign key to auth_users: with authentication disabled the single user is id 0.
       Deleting an account removes its rows in Service.DeleteUser. -->
  <createTable tableName="index_sources" remarks="A constituent list a user imported or fetched with their own key, as JSON">
   <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
   <column name="index_id" type="VARCHAR(64)"><constraints nullable="false"/></column>
   <column name="data" type="MEDIUMTEXT"><constraints nullable="false"/></column>
   <column name="updated_at" type="DATETIME(6)" defaultValueComputed="CURRENT_TIMESTAMP(6)"><constraints nullable="false"/></column>
  </createTable>
  <addPrimaryKey tableName="index_sources" columnNames="user_id,index_id" constraintName="pk_index_sources"/>
  <rollback><dropTable tableName="index_sources"/></rollback>
 </changeSet>
</databaseChangeLog>
