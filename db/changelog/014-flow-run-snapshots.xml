<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="014-flow-run-snapshots" author="floweysales" dbms="mysql">
  <createTable tableName="agent_flow_run_snapshots">
   <column name="run_id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
   <column name="graph_json" type="LONGTEXT"><constraints nullable="false"/></column>
  </createTable>
  <addForeignKeyConstraint baseTableName="agent_flow_run_snapshots" baseColumnNames="run_id"
   referencedTableName="agent_flow_runs" referencedColumnNames="id" constraintName="fk_flow_snapshot_run" onDelete="CASCADE"/>
  <rollback><dropTable tableName="agent_flow_run_snapshots"/></rollback>
 </changeSet>
</databaseChangeLog>
