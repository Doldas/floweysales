<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="050-broker-order-events" author="floweysales" dbms="mysql">
  <!-- The history of an order routed to a broker extension (#444): one row per step, only ever added.
       Rows go with their order (ON DELETE CASCADE), so deleting a user's broker_orders removes the history. -->
  <createTable tableName="broker_order_events" remarks="Append-only history of orders routed to broker extensions">
   <column name="id" type="BIGINT" autoIncrement="true"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_broker_order_events"/></column>
   <column name="ledger_id" type="BIGINT"><constraints nullable="false"/></column>
   <column name="user_id" type="BIGINT"><constraints nullable="false"/></column>
   <column name="created_at" type="DATETIME(6)"><constraints nullable="false"/></column>
   <column name="kind" type="VARCHAR(16)"><constraints nullable="false"/></column>
   <column name="status" type="VARCHAR(12)"><constraints nullable="false"/></column>
   <column name="order_status" type="VARCHAR(16)" defaultValue=""><constraints nullable="false"/></column>
   <column name="filled_quantity" type="DECIMAL(24,8)" defaultValueNumeric="0"><constraints nullable="false"/></column>
   <column name="average_price" type="DECIMAL(24,8)" defaultValueNumeric="0"><constraints nullable="false"/></column>
   <column name="detail" type="VARCHAR(1000)" defaultValue=""><constraints nullable="false"/></column>
  </createTable>
  <createIndex tableName="broker_order_events" indexName="idx_broker_order_events_ledger"><column name="ledger_id"/><column name="id"/></createIndex>
  <addForeignKeyConstraint baseTableName="broker_order_events" baseColumnNames="ledger_id"
   referencedTableName="broker_orders" referencedColumnNames="id" constraintName="fk_broker_order_events_ledger" onDelete="CASCADE"/>
  <rollback>
   <dropTable tableName="broker_order_events"/>
  </rollback>
 </changeSet>
</databaseChangeLog>
