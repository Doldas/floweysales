<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="006-trading-tables" author="floweysales" dbms="mysql">
  <createTable tableName="trading_history">
   <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
   <column name="timestamp" type="BIGINT"><constraints nullable="false"/></column>
   <column name="symbol" type="VARCHAR(64)"><constraints nullable="false"/></column>
   <column name="provider" type="VARCHAR(32)" defaultValue="LEGACY"/>
   <column name="price" type="DOUBLE"/>
   <column name="stop_loss" type="DOUBLE"/>
   <column name="fast_ema" type="DOUBLE"/>
   <column name="slow_ema" type="DOUBLE"/>
   <column name="currency" type="VARCHAR(12)"/>
   <column name="status" type="VARCHAR(255)"/>
   <column name="rawJson" type="LONGTEXT"/>
  </createTable>
  <createIndex tableName="trading_history" indexName="idx_ticks_symbol_id">
   <column name="symbol"/><column name="provider"/><column name="id"/>
  </createIndex>
  <createTable tableName="orders">
   <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
   <column name="symbol" type="VARCHAR(64)"><constraints nullable="false"/></column>
   <column name="side" type="VARCHAR(12)"><constraints nullable="false"/></column>
   <column name="type" type="VARCHAR(32)" defaultValue="MARKET"/>
   <column name="tif" type="VARCHAR(12)" defaultValue="GTC"/>
   <column name="amount" type="DOUBLE" defaultValueNumeric="0"/>
   <column name="quantity" type="DOUBLE" defaultValueNumeric="0"/>
   <column name="price" type="DOUBLE" defaultValueNumeric="0"/>
   <column name="limit_price" type="DOUBLE" defaultValueNumeric="0"/>
   <column name="stop_price" type="DOUBLE" defaultValueNumeric="0"/>
   <column name="fill_price" type="DOUBLE" defaultValueNumeric="0"/>
   <column name="fee" type="DOUBLE" defaultValueNumeric="0"/>
   <column name="timestamp" type="BIGINT"><constraints nullable="false"/></column>
   <column name="filled_at" type="BIGINT" defaultValueNumeric="0"/>
   <column name="status" type="VARCHAR(32)" defaultValue="OPEN"/>
   <column name="reason" type="TEXT"/>
  </createTable>
  <createIndex tableName="orders" indexName="idx_orders_symbol_status"><column name="symbol"/><column name="status"/></createIndex>
  <createTable tableName="forum_posts">
   <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
   <column name="author" type="VARCHAR(255)"><constraints nullable="false"/></column>
   <column name="title" type="VARCHAR(500)"><constraints nullable="false"/></column>
   <column name="content" type="LONGTEXT"><constraints nullable="false"/></column>
   <column name="symbol" type="VARCHAR(64)"/>
   <column name="timestamp" type="BIGINT"><constraints nullable="false"/></column>
   <column name="upvotes" type="INT" defaultValueNumeric="0"/>
  </createTable>
  <rollback><dropTable tableName="forum_posts"/><dropTable tableName="orders"/><dropTable tableName="trading_history"/></rollback>
 </changeSet>
 <changeSet id="007-active-trackers" author="floweysales" dbms="mysql">
  <createTable tableName="tracked_assets">
   <column name="symbol" type="VARCHAR(64)"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_tracked_assets"/></column>
   <column name="provider" type="VARCHAR(32)"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_tracked_assets"/></column>
   <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
  </createTable>
  <rollback><dropTable tableName="tracked_assets"/></rollback>
 </changeSet>
 <changeSet id="008-tracker-bootstrap-marker" author="floweysales" dbms="mysql">
  <createTable tableName="tracker_runtime_meta">
   <column name="id" type="TINYINT"><constraints nullable="false" primaryKey="true"/></column>
   <column name="initialized_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
  </createTable>
  <rollback><dropTable tableName="tracker_runtime_meta"/></rollback>
 </changeSet>
</databaseChangeLog>
